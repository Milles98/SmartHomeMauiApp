<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TodoApp.ViewModels"
             xmlns:pages="clr-namespace:TodoApp.Pages"
             xmlns:models="clr-namespace:Shared.Library.Models;assembly=Shared.Library"
             x:DataType="{x:Type viewModels:MainViewModel}"
             x:Class="TodoApp.Pages.MainPage"
             Title="MainPage">

    <ScrollView>

        <Grid RowDefinitions="auto, *"
              Margin="20">

            <VerticalStackLayout Grid.Row="0">
                <Label Text="Activity"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Entry Text="{Binding TodoItem.Activity}" />
                <Button Command="{Binding SaveTodoCommand}"
                        Text="Save Activity"
                        Margin="0, 20, 0, 0" />
            </VerticalStackLayout>

            <CollectionView Margin="0, 20, 0, 0"
                            Grid.Row="1"
                            ItemsSource="{Binding TodoItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type models:TodoItem}">
                        <Grid ColumnDefinitions="*, auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Activity}"
                                       FontSize="16" />
                                <Label Text="{Binding Created}"
                                       FontSize="11" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Margin="10"
                                    FontFamily="fa-solid"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=BindingContext.RemoveTodoItemCommand}"
                                    FontSize="16"
                                    Text="&#xf2ed;" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </ScrollView>

</ContentPage>