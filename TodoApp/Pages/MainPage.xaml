<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TodoApp.ViewModels"
             xmlns:pages="clr-namespace:TodoApp.Pages"
             x:DataType="{x:Type viewModels:MainViewModel}"
             x:Class="TodoApp.Pages.MainPage"
             Title="MainPage">

    <ScrollView>

        <VerticalStackLayout>
            <Label Text="Activity"
                   FontSize="12" />
            <Entry Text="{Binding TodoItem.Activity}" />
            <Button />
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>