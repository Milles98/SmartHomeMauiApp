<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHomeMauiApp.MVVM.Views.AddDevicePage"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             x:DataType="{x:Type viewModels:AddDeviceViewModel}"
             BackgroundColor="#0f0f0f">

    <!-- Main Grid Layout -->
    <Grid>
        <!-- Background Image -->
        <Image Source="maui_background.png"
               Aspect="AspectFill"
               Opacity="0.2" />

        <!-- Main Content -->
        <ScrollView>
            <StackLayout Padding="30"
                         Spacing="20"
                         VerticalOptions="CenterAndExpand"
                         HorizontalOptions="CenterAndExpand"
                         BackgroundColor="Transparent">

                <!-- Home Button -->
                <Button Text="&#xf015;"
                        FontSize="18"
                        FontFamily="fa-solid"
                        Margin="0,10,0,0"
                        Command="{Binding NavigateHomeCommand}"
                        HorizontalOptions="Start"/>

                <!-- Title -->
                <Label Text="Add New Device"
                       FontSize="Large"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <!-- Device Type Dropdown -->
                <Picker Title="Select Device Type"
                        Background="#333"
                        ItemsSource="{Binding AvailableDeviceTypes}"
                        SelectedItem="{Binding SelectedDeviceType}"
                        HorizontalOptions="FillAndExpand" />

                <!-- Device ID Display -->
                <Label Text="Generated Device ID:"
                       FontSize="Medium"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="{Binding DeviceId}"
                       FontSize="Small"
                       TextColor="Gray"
                       HorizontalOptions="FillAndExpand" />

                <!-- Generate Device ID Button -->
                <Button Text="Generate Device ID"
                        Command="{Binding GenerateDeviceIdCommand}"
                        BackgroundColor="DodgerBlue"
                        TextColor="White"
                        HorizontalOptions="Center" />

                <!-- Add Device Button -->
                <Button Text="Add Device"
                        Command="{Binding AddDeviceCommand}"
                        BackgroundColor="Green"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand" />

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
