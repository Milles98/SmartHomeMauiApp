<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHomeMauiApp.MVVM.Views.AddDevicePage"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             x:DataType="{x:Type viewModels:AddDeviceViewModel}"
             BackgroundColor="#0f0f0f">

    <Grid>
        <Image Source="maui_background.png"
               Aspect="AspectFill"
               Opacity="0.2" />

        <ScrollView>
            <StackLayout Padding="30"
                         Spacing="20"
                         WidthRequest="500"
                         VerticalOptions="CenterAndExpand"
                         HorizontalOptions="CenterAndExpand"
                         BackgroundColor="Transparent">

                <Label Text="Add New Device"
                       FontSize="Large"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <Picker Title="Select Device Type"
                        Background="#333"
                        ItemsSource="{Binding AvailableDeviceTypes}"
                        SelectedItem="{Binding SelectedDeviceType}"
                        HorizontalOptions="FillAndExpand" />

                <Entry Placeholder="Enter Desired Device Name"
                       Text="{Binding DeviceName}"
                       BackgroundColor="#333"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       FontSize="14"
                       HeightRequest="20"
                       HorizontalOptions="FillAndExpand"
                       Margin="0,0,0,0" />

                <Label Text="Generated Device ID:"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />
                <Label Text="{Binding DeviceId}"
                       FontSize="Small"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray"
                       HorizontalOptions="FillAndExpand" />

                <Button Text="Generate Device ID"
                        Command="{Binding GenerateDeviceIdCommand}"
                        BackgroundColor="DodgerBlue"
                        TextColor="White"
                        HorizontalOptions="Center" />

                <Button Text="Add Device"
                        Command="{Binding AddDeviceCommand}"
                        BackgroundColor="Green"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand" />

                <Label Text="{Binding ResponseMessage}"
                       FontSize="Medium"
                       TextColor="{Binding ResponseMessageColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding ResponseMessage, Converter={StaticResource StringToVisibilityConverter}}" />


            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
