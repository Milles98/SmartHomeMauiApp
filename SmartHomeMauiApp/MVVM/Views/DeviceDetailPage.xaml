<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHomeMauiApp.MVVM.Views.DeviceDetailPage"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             x:DataType="{x:Type viewModels:DeviceDetailViewModel}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="auto, auto"
              Margin="30">

            <Button Grid.Row="0"
                    Text="&#xf015;"
                    FontSize="18"
                    FontFamily="fa-solid"
                    Margin="25,0,0,0"
                    BackgroundColor="#6f42c1"
                    TextColor="White"
                    Command="{Binding NavigateHomeCommand}"
                    HorizontalOptions="Start">
                <Button.Shadow>
                    <Shadow Brush="Black"
                            Offset="2,2"
                            Opacity="0.4" />
                </Button.Shadow>
            </Button>

            <StackLayout Grid.Row="1"
                         Padding="20">

                <Label Text="Device ID:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding DeviceId}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Device Name:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding DeviceName}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Device Type:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding DeviceType}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Connection State:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding ConnectionState}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Last Activity Time:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding LastActivityTime}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Device State:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding DeviceState}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Button Text="Toggle Device State"
                        Command="{Binding ToggleStateCommand}"
                        BackgroundColor="Green"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />

                <Button Text="Remove Device"
                        Command="{Binding RemoveDeviceCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />
            </StackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
