<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHomeMauiApp.MVVM.Views.DeviceDetailPage"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             x:DataType="{x:Type viewModels:DeviceDetailViewModel}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>


        <Grid RowDefinitions="auto, auto"
              Margin="30">


            <Button Grid.Row="0"
                    Text="&#xf015;"
                    FontSize="18"
                    FontFamily="fa-solid"
                    Margin="25,0,0,0"
                    Command="{Binding NavigateHomeCommand}"
                    HorizontalOptions="Start" />

            <StackLayout Grid.Row="1"
                         Padding="20">

                <Label Text="Device ID:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding DeviceId}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Status:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding Status}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Connection State:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding ConnectionState}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Last Activity Time:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding LastActivityTime}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Label Text="Fan State:"
                       FontAttributes="Bold"
                       Margin="10,0,0,0" />
                <Label Text="{Binding FanState}"
                       FontAttributes="Italic"
                       Margin="10, 0, 0, 10" />

                <Button Text="Connect Device"
                        Command="{Binding ConnectDeviceCommand}"
                        BackgroundColor="Blue"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />

                <Button Text="Disconnect Device"
                        Command="{Binding DisconnectDeviceCommand}"
                        BackgroundColor="DarkBlue"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />

                <Button Text="Toggle Fan State"
                        Command="{Binding ToggleFanStateCommand}"
                        BackgroundColor="Green"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />

                <Button Text="Remove Device"
                        Command="{Binding RemoveDeviceCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />

                <Label Text="Currently buggy? Refresh below"
                       Margin="10,0,0,0"
                       HorizontalOptions="Center" />
                <Button Text="Refresh Device Details"
                        Command="{Binding LoadDeviceDetailsCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"
                        Margin="10, 20, 10, 0" />
            </StackLayout>


        </Grid>
    </ScrollView>


</ContentPage>