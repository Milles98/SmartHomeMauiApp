<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             xmlns:views="clr-namespace:SmartHomeMauiApp.MVVM.Views"
             x:DataType="{x:Type viewModels:MainViewModel}"
             xmlns:azureshared="clr-namespace:Microsoft.Azure.Devices.Shared;assembly=Microsoft.Azure.Devices.Shared"
             x:Class="SmartHomeMauiApp.MVVM.Views.MainPage"
             BackgroundColor="Black">

    <Grid>

        <Image Source="maui_background.png"
               Aspect="AspectFill"
               Opacity="0.4"
               IsEnabled="False" />

        <!-- Main content area -->
        <CollectionView ItemsSource="{Binding Devices}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDevice}"
                        SelectionChangedCommand="{Binding NavigateToDeviceDetailCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type azureshared:Twin}">
                    <Frame BorderColor="Gray"
                           CornerRadius="10"
                           Margin="10"
                           Padding="10"
                           BackgroundColor="#1e1e1e">
                        <Grid ColumnDefinitions="Auto, *"
                              RowDefinitions="Auto, Auto">
                            <!-- Device Status Indicator -->
                            <BoxView WidthRequest="10"
                                     HeightRequest="10"
                                     CornerRadius="5"
                                     Color="{Binding ConnectionState, Converter={StaticResource BooleanToColorConverter}}"
                                     VerticalOptions="Center"
                                     Margin="0,0,5,0" />

                            <!-- Device ID -->
                            <Label Grid.Column="1"
                                   Text="{Binding DeviceId}"
                                   FontSize="Medium"
                                   TextColor="White"
                                   VerticalOptions="Center" />

                            <!-- Clickable area -->
                            <Button Grid.ColumnSpan="2"
                                    Text="Details"
                                    VerticalOptions="End"
                                    HorizontalOptions="End"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=NavigateToDeviceDetailCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>

</ContentPage>
