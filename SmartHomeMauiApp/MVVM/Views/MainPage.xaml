<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             xmlns:views="clr-namespace:SmartHomeMauiApp.MVVM.Views"
             x:DataType="{x:Type viewModels:MainViewModel}"
             xmlns:azureshared="clr-namespace:Microsoft.Azure.Devices.Shared;assembly=Microsoft.Azure.Devices.Shared"
             x:Class="SmartHomeMauiApp.MVVM.Views.MainPage"
             BackgroundColor="Black">

    <Grid>

        <Image Source="maui_background.png"
               Aspect="AspectFill"
               Opacity="0.4"
               IsEnabled="False" />

        <!-- Main content area -->
        <CollectionView ItemsSource="{Binding Devices}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDevice}"
                        SelectionChangedCommand="{Binding ToggleDeviceStateCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type azureshared:Twin}">
                    <Grid>
                        <VerticalStackLayout>
                            <Label Text="{Binding DeviceId}"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>

</ContentPage>
