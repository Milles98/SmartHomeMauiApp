<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             xmlns:views="clr-namespace:SmartHomeMauiApp.MVVM.Views"
             x:DataType="{x:Type viewModels:MainViewModel}"
             xmlns:azureshared="clr-namespace:Microsoft.Azure.Devices.Shared;assembly=Microsoft.Azure.Devices.Shared"
             x:Class="SmartHomeMauiApp.MVVM.Views.MainPage"
             BackgroundColor="#1a1a1a">

    <Grid>

        <Image Source="maui_background.png"
               Aspect="AspectFill"
               Opacity="0.4"
               IsEnabled="False" />

        <!-- Main content area -->
        <CollectionView ItemsSource="{Binding Devices}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedDevice}"
                        SelectionChangedCommand="{Binding NavigateToDeviceDetailCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type azureshared:Twin}">
                    <Frame BorderColor="Gray"
                           CornerRadius="10"
                           Margin="10"
                           Padding="10"
                           BackgroundColor="#1e1e1e"
                           HeightRequest="180">
                        <Grid ColumnDefinitions="Auto, *, Auto"
                              RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                            <!-- Fan Icon -->
                            <Image Grid.Row="3"
                                   Grid.RowSpan="2"
                                   Grid.Column="0"
                                   Source="fan_icon.png"
                                   Margin="0,0,0,0"
                                   HeightRequest="80"
                                   WidthRequest="80" />

                            <!-- Device ID -->
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="4"
                                   Text="{Binding DeviceId}"
                                   FontSize="14"
                                   Margin="0,5,0,0"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Last Activity Time -->
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,10,0,0"
                                   Text="Last Activity:"
                                   FontSize="Small"
                                   TextColor="Gray"/>
                            <Label Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="20,10,0,0"
                                   Text="{Binding LastActivityTime}"
                                   FontSize="Small"
                                   TextColor="White"/>

                            <!-- Fan State -->
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Connection:"
                                   FontSize="Small"
                                   TextColor="Gray"/>
                            <Label Grid.Row="3"
                                   Grid.Column="2"
                                   Margin="20,0,0,0"
                                   Text="{Binding ConnectionState}"
                                   FontSize="Small"
                                   TextColor="White"/>

                            <!-- Details Button -->
                            <Button Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,20,0,15"
                                    Text="Details"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=NavigateToDeviceDetailCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>

</ContentPage>
