<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             xmlns:views="clr-namespace:SmartHomeMauiApp.MVVM.Views"
             x:DataType="{x:Type viewModels:MainViewModel}"
             xmlns:azureshared="clr-namespace:Microsoft.Azure.Devices.Shared;assembly=Microsoft.Azure.Devices.Shared"
             x:Class="SmartHomeMauiApp.MVVM.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0f0f0f">

    <ScrollView>
        <Grid>

            <Image Source="maui_background.png"
                   Aspect="AspectFill"
                   Opacity="0.2"
                   IsEnabled="False" />

            <Grid RowDefinitions="auto, *"
                  Padding="30">

                <Button Grid.Row="0"
                        Text="&#xf013;"
                        FontSize="24"
                        Command="{Binding NavigateToSettingsCommand}"
                        FontFamily="fa-solid"
                        BackgroundColor="#6f42c1"
                        TextColor="White"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black"
                                Offset="2,2"
                                Opacity="0.4" />
                    </Button.Shadow>
                </Button>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Devices}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedDevice}"
                                SelectionChangedCommand="{Binding NavigateToDeviceDetailCommand}"
                                Margin="0,20,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type azureshared:Twin}">
                            <Frame BorderColor="#333"
                                   CornerRadius="15"
                                   Margin="10"
                                   Padding="15"
                                   BackgroundColor="{DynamicResource SemiTransparentGray}"
                                   HasShadow="True"
                                   HeightRequest="120">
                                <Grid ColumnDefinitions="80, *, Auto"
                                      RowDefinitions="Auto, Auto"
                                      Padding="5"
                                      VerticalOptions="CenterAndExpand">

                                    <Image Grid.RowSpan="2"
                                           Grid.Column="0"
                                           Source="{Binding ., Converter={StaticResource DeviceTypeToImageConverter}}"
                                           HeightRequest="60"
                                           WidthRequest="60"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                    <StackLayout Grid.Row="0"
                                                 Grid.Column="1"
                                                 Padding="10,0,0,0"
                                                 VerticalOptions="Center">
                                        <Label Text="{Binding DeviceId}"
                                               FontSize="Medium"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="Last Activity:"
                                               FontSize="Small"
                                               TextColor="Gray"
                                               Margin="0,5,0,0" />
                                        <Label Text="{Binding LastActivityTime, StringFormat='{}{0:MM/dd/yyyy hh:mm tt}'}"
                                               FontSize="Small"
                                               TextColor="White" />
                                    </StackLayout>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Text="Details"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            BackgroundColor="#6f42c1"
                                            TextColor="White"
                                            CornerRadius="20"
                                            WidthRequest="80"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, Path=NavigateToDeviceDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            Margin="5">
                                        <Button.Shadow>
                                            <Shadow Brush="Black"
                                                    Offset="2,2"
                                                    Opacity="0.4" />
                                        </Button.Shadow>
                                    </Button>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Button Text="&#x2b;"
                    FontSize="24"
                    FontFamily="fa-solid"
                    Command="{Binding NavigateToAddDeviceCommand}"
                    CornerRadius="30"
                    BackgroundColor="#6f42c1"
                    TextColor="White"
                    WidthRequest="60"
                    HeightRequest="60"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="30"
                    AbsoluteLayout.LayoutBounds="1, 1, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional">
                <Button.Shadow>
                    <Shadow Brush="Black"
                            Offset="2,2"
                            Opacity="0.4" />
                </Button.Shadow>
            </Button>
        </Grid>
    </ScrollView>
</ContentPage>
