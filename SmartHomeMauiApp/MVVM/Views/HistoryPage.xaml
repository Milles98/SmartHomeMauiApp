<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartHomeMauiApp.MVVM.ViewModels"
             xmlns:models="clr-namespace:Shared.Library.Models;assembly=Shared.Library"
             x:Class="SmartHomeMauiApp.MVVM.Views.HistoryPage"
             x:DataType="{x:Type viewModels:HistoryViewModel}"
             BackgroundColor="#0f0f0f">

    <ScrollView>
        <Grid>

            <Image Source="maui_background.png"
                   Aspect="AspectFill"
                   Opacity="0.2"
                   IsEnabled="False" />

            <Grid RowDefinitions="auto, *"
                  Padding="30">

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*,*"
                      Margin="0,30,0,0"
                      VerticalOptions="StartAndExpand"
                      HorizontalOptions="CenterAndExpand">

                    <StackLayout Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 Padding="10">
                        <Label Text="Devices stored in the database"
                               FontAttributes="Bold"
                               FontSize="{OnPlatform Android='14', WinUI='26'}"
                               Margin="{OnPlatform Android='0,0,0,10'}"
                               HorizontalOptions="Center"
                               TextColor="White" />

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding DeviceSettings}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="{OnPlatform Android='1', WinUI='4'}"
                                                 HorizontalItemSpacing="10"
                                                 VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type models:DeviceSettings}">
                                    <Frame BorderColor="#333"
                                           CornerRadius="10"
                                           Padding="5"
                                           BackgroundColor="{DynamicResource SemiTransparentGray}"
                                           HasShadow="True"
                                           HeightRequest="{OnPlatform Android='150', WinUI='130'}"
                                           WidthRequest="{OnPlatform Android='200', WinUI='172'}">
                                        <StackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                            <Image Source="{Binding ., Converter={StaticResource DeviceSettingsTypeToImageConverter}}"
                                                   HeightRequest="40"
                                                   WidthRequest="40"
                                                   HorizontalOptions="Center"
                                                   Margin="0,5" />

                                            <Label Text="{Binding DeviceName}"
                                                   FontSize="16"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Margin="0,2" />

                                            <Label Text="{Binding DeviceType}"
                                                   FontSize="14"
                                                   TextColor="Gray"
                                                   HorizontalOptions="Center"
                                                   Margin="0,2" />

                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding DeviceId, Converter={StaticResource TruncateDeviceIdConverter}}"
                                                              FontSize="12"
                                                              TextColor="LightBlue" />
                                                        <Span Text=" (Tap to view)"
                                                              FontSize="12"
                                                              TextColor="Gray" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HistoryViewModel}}, Path=ShowFullDeviceIdCommand}"
                                                                          CommandParameter="{Binding DeviceId}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
