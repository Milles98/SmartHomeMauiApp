<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SmartHomeMauiApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SmartHomeMauiApp.MVVM.Views"
       Shell.FlyoutBehavior="Flyout"
       Title="SmartHomeMauiApp"
       BackgroundColor="#f0f0f0">

    <FlyoutItem Title="SmartHome Control Panel">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#xf015;"
                             FontFamily="fa-solid"
                             Size="20"
                             Color="Black" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate views:MainPage}"
                      Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#xf013;"
                             FontFamily="fa-solid"
                             Size="20"
                             Color="Black" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </FlyoutItem>

    <ShellContent Title="Device Detail"
                  ContentTemplate="{DataTemplate views:DeviceDetailPage}"
                  Route="DeviceDetailPage"
                  FlyoutItemIsVisible="False" />

</Shell>
